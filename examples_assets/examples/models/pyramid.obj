# A square pyramid, 1 m wide and 1 m tall, with two materials from pyramid.mtl.
# 'usemtl' switches the material for the faces after it, so the base and the sides import as two sections (material slots).
mtllib pyramid.mtl
o Pyramid
v -0.5 0 -0.5
v 0.5 0 -0.5
v 0.5 0 0.5
v -0.5 0 0.5
v 0 1 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0.5 1
vn 0 -1 0
vn 0 0.4472 -0.8944
vn 0.8944 0.4472 0
vn 0 0.4472 0.8944
vn -0.8944 0.4472 0
usemtl Base
f 1/1/1 2/2/1 3/3/1 4/4/1
usemtl Sides
f 1/1/2 5/5/2 2/2/2
f 2/1/3 5/5/3 3/2/3
f 3/1/4 5/5/4 4/2/4
f 4/1/5 5/5/5 1/2/5
